// Global default params, used in configs
params {

    // Input & references options
    reference_genomes          = null

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    monochromeLogs               = false      // required so nf-validation nextflow.enabled.strict works nicely together
    hook_url                     = null
    help                         = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'


    // Personalised params
    samplesheet     = 'samplesheet.csv'
    input_folder    = null
    file_suffix     = ".fastq.gz"
    file_spacer     = "_"
    publish_dir_mode = 'copy'
    cpus            = 16
    memory_gb       = 20

    // Preprocessing params
    skip_preprocessing_qc           = false
    perform_shortread_qc            = true
    shortread_qc_contaminantslist   = null      // https://github.com/BioInfoTools/BBMap/blob/master/resources/adapters.fa OR "/home/vinoy_ramachandran_nibsc_org/.conda/pkgs/bbtools-37.62-0/bbtools/lib/resources/adapters.fa"
    qc_tool                         = null
    bbmerge_pairs                   = true
    //perform_runmerging          = false


    // MetaPhlAn params
    run_metaphlan = true
    installdb = true  
    metaphlan_index = null
    metaphlan_db = null
    s = true
    min_alignment_len = null
    min_mapq_val = 5
    tax_lev = 'a'
    min_cu_len = 2000
    add_viruses = false
    ignore_eukaryotes = false
    ignore_archaea = false
    ignore_bacteria = false
    unclassified_estimation = true

    // StrainPhlAn params
    run_strainphlan = false
    strainphlan_clades = null
    skip_strainphlan_prep = false
    mutation_rates = true
    strainphlan_db = null
    consensus_markers = "consensus_markers/"
    clade_markers = "./clade_markers/"
    metadata = null

    // GraphPlAn
    graphlan_plots = false

    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    // Schema validation default options
    validationFailUnrecognisedParams = false
    validationLenientMode            = false
    validationSchemaIgnoreParams     = 'genomes,igenomes_base'
    validationShowHiddenParams       = false
    validate_params                  = true

}

