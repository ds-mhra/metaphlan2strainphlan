// Load base.config by default for all pipelines
includeConfig 'conf/base.config'


bucket_name="mhra-ngs-dev-ut8t"
project_id="mhra-ngs-dev-ut8t"

profiles {
    gcb {
        process.executor = 'google-batch'
        workDir = "gs://${bucket_name}/workdir/"
        google.project = "${project_id}"
        google.location = 'europe-west2'
        google.zone = 'europe-west2-c'
        google.batch.spot = false
        google.batch.machineType = 'n1-standard-8'
        google.batch.usePrivateAddress = true
        google.batch.network = "global/networks/${project_id}-network"
        google.batch.subnetwork ='regions/europe-west2/subnetworks/mhra-ngs-dev-eu-west2-1'
        google.batch.serviceAccountEmail = "nextflow-vm@${project_id}.iam.gserviceaccount.com" 
        google.batch.bootDiskSize    = '50.GB'
    }
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda', 'defaults']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        singularity.pullTimeout = "3 hours"     // the default is 20 minutes and fails with large images
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    test {
        includeConfig 'conf/test.config'
        params.input = params.samplesheet      // set samplesheet to default value of 'input' defined in conf/test.config
        installdb               = true         // ensures latest database is downloaded for the test profile
    }
    test_full { includeConfig 'conf/test_full.config' }
}

// Sets default registry for Docker and Singularity independent of `-profile`. Will not be used unless it is enabled
apptainer.registry   = 'quay.io'
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'
singularity.registry = 'quay.io'



// Allows any negative samples or unknown clades that fail the METAPHLAN_METAPHLAN & STRAINPHLAN_PREP_CLADES processes to be skipped, but still reports error message upon completion.
workflow.failOnIgnore = true

process {

    stageInMode = 'symlink'

    withName: 'BBMAP_BBDUK|BBMAP_BBDUK_SINGLE | BBMAP_BBDUK_PAIRED' {       // BBMAP_BBDUK
        ext.args   = 'tpe tbo ktrim=r k=21 mink=8 hdist=2 qtrim=r ftl=15 trimq=20 minlen=75 t=36'
        // Publish the filtered reads and log files
        publishDir = [
            [
                path: { "${params.outdir}/bbduk/" },
                mode: params.publish_dir_mode,
                pattern: '*.{fastq.gz}',
                overwrite: true
                //enabled: params.save_filtered_reads
            ],
            [
                path: { "${params.outdir}/bbduk/" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }
    withName: 'BBMAP_BBMERGE' {
        memory     = '10 G'
        cpus       = '12'
        time       = '2 h'
        publishDir = [
            [
                path: { "${params.outdir}/bbmerge/merged_fastq" },
                mode: params.publish_dir_mode,
                pattern: '*_merged.{fastq.gz}',
                overwrite: true
                //enabled: params.save_merged_reads
            ],
            [
                path: { "${params.outdir}/bbmerge/" },
                mode: params.publish_dir_mode,
                // pattern: '*.{fastq.gz,bbduk.log}', 
                overwrite: true
            ]
        ]
    }
    withName: 'FASTQC_PRE' {
        publishDir = [
            path: { "${params.outdir}/fastqc_pre/" },
            overwrite: true,
            mode: params.publish_dir_mode
        ] 
    }
    withName: 'FASTQC_POST' {
        publishDir = [
            path: { "${params.outdir}/fastqc_post/" },
            overwrite: true,
            mode: params.publish_dir_mode
        ] 
    }
    withName: 'METAPHLAN_MAKEDB' {
        ext.args = "--index ${params.metaphlan_index} --nproc 22"
        memory     = '38 G'
        cpus       = '32'
        errorStrategy = 'retry'
        time       = '2 h'
        conda      = 'bioconda/metaphlan=4.1.1'
        publishDir = [
            path: { "${params.outdir}" },                       
            overwrite: true,
            mode: params.publish_dir_mode
        ]
    }
    withName: 'METAPHLAN_METAPHLAN' {
        ext.args = '--unclassified_estimation --no_map'
        memory     = '40 G'
        cpus       = '52' 
        conda      = 'bioconda/metaphlan=4.1.1'
        // maxRetries = 1           // for negative samples
        // maxErrors  = 1           // for negative samples
        errorStrategy   = 'ignore'
        publishDir = [
            [
            path: { "${params.outdir}/metaphlan/sam/" },
            mode: params.publish_dir_mode,
            overwrite: true,
            pattern: '*.sam.bz2'
            ],
            [
            path: { "${params.outdir}/metaphlan/biom/" },
            mode: params.publish_dir_mode,
            overwrite: true,
            pattern: '*.biom'
            ],
            [
            path: { "${params.outdir}/metaphlan/profiles/" },
                mode: params.publish_dir_mode,
                overwrite: true,
                pattern: '*_profile.txt'
            ],
            [
            path: { "${params.outdir}/metaphlan/bwt2/" },
                mode: params.publish_dir_mode,
                overwrite: true,
                pattern: '*.bowtie2out.txt'
            ]
        ]
    }
    withName: 'METAPHLAN_MERGEMETAPHLANTABLES' {
        ext.args = '--overwrite'
        // ext.prefix = { "metaphlan_combined_profile_report" }
        publishDir = [
            path: { "${params.outdir}/metaphlan/" },
                mode: params.publish_dir_mode,
                overwrite: true,
                pattern: '*.txt'
        ]
    }
    withName: 'GENERATE_ABUNDANCE_TABLES' {
        publishDir = [
            path: { "${params.outdir}/abundance_and_taxons/" },
                mode: params.publish_dir_mode,
                overwrite: true,
                pattern: '*.txt'
        ]
    }
    withName: 'STRAINPHLAN_PREP_CONSENSUS' {
        cpus = 48
        publishDir = [
            [
            path: { "${params.outdir}/strainphlan/" },
            mode: params.publish_dir_mode,
            overwrite: true
            ]
        ]
    }
    withName: 'STRAINPHLAN_PREP_CLADES' {
        cpus            = 62
        maxRetries      = 1
        errorStrategy   = 'ignore'
        publishDir = [
            [
            path: { "${params.outdir}/strainphlan/" },
            mode: params.publish_dir_mode,
            overwrite: true
            ]
        ]
    }
    withName: 'STRAINPHLAN_STRAINPHLAN' {
        maxRetries = 0
        ext.args   = '--debug --phylophlan_mode fast'        // --tmp "tmp"
        cpus       = 58
        publishDir = [
            path: { "${params.outdir}/strainphlan/strainphlan_output/" },
            mode: params.publish_dir_mode,
            overwrite: true
        ]
    }
    withName: 'STRAINPHLAN_METADATA' {
        //ext.args   = '--colorized_metadata'  //--colorized_metadata colorized_metadata_field
        publishDir = [
            path: { "${params.outdir}/strainphlan/strainphlan_output/" },
            mode: params.publish_dir_mode,
            overwrite: true
        ]
    }
    withName: 'MULTIQC' {
        memory     = '16 G'
        cpus       = '20'
    }
}



// Nextflow plugins
plugins {
    id 'nf-validation@1.1.3' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}


// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
    overwrite = true
}
// added for gc fusion file system
fusion {
    enabled = true
}
wave {
    enabled = true
}
process.scratch = false


manifest {
    name            = 'nf-core/metaphlanstrainphlan'
    author          = """Dammy Shittu"""
    homePage        = 'https://github.com/ds-mhra/metaphlanstrainphlan'
    description     = """Pipeline carries out taxonomy analysis on metagenomic sequencing by pre-processing reads and using metaphlan and strainphlan.\n"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0dev'
    doi             = ''
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// Function to ensure that resource requirements don't go beyond
// a maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
